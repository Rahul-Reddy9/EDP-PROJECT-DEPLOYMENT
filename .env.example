# =============================================================================
# FRAUDGUARD AI — ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' and populate with production secrets before deployment.
# Never commit active credentials or signing secrets to version control.

# -----------------------------------------------------------------------------
# 1. Environment Designation
# -----------------------------------------------------------------------------
# Options: 'development', 'staging', 'production'
# In 'production' mode, missing secrets or default passwords will safely abort startup.
ENV=development

# -----------------------------------------------------------------------------
# 2. Cryptographic JWT Authentication & Token Security
# -----------------------------------------------------------------------------
# REQUIRED in production: Cryptographically strong signing key (minimum 32 characters, high entropy).
# In development mode, dynamically generated if omitted.
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production

# JWT Token Expiration window (in minutes). Default is 60 minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# 3. Administrative & User RBAC Credentials
# -----------------------------------------------------------------------------
# Administrator password for 'admin' / 'mlops_admin' account (minimum 12 characters in production).
# REQUIRED in production mode.
FRAUDGUARD_ADMIN_PASSWORD=replace-with-strong-admin-password-min12chars

# Risk analyst password for 'analyst' / 'user' account (minimum 8 characters in production).
# REQUIRED in production mode.
FRAUDGUARD_USER_PASSWORD=replace-with-strong-user-password-min8chars

# -----------------------------------------------------------------------------
# 4. CORS Allowed Origins
# -----------------------------------------------------------------------------
# Comma-separated list of trusted client origins.
# Wildcards ('*') are strictly disallowed when credentials are enabled.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# -----------------------------------------------------------------------------
# 5. Sliding-Window Rate Limiting (Requests per 60-Second Window)
# -----------------------------------------------------------------------------
# Rate limit for authentication endpoints (POST /auth/login, POST /auth/token)
RATE_LIMIT_LOGIN=5

# Rate limit for inference endpoints (POST /predict, POST /predict/batch, POST /predict/csv)
RATE_LIMIT_PREDICT=60

# -----------------------------------------------------------------------------
# 6. Denial-of-Service (DoS) and Payload Protections
# -----------------------------------------------------------------------------
# Maximum request body size in bytes (Default: 10485760 = 10 MB) -> Returns HTTP 413
MAX_REQUEST_SIZE_BYTES=10485760

# Maximum transactions permitted per batch prediction -> Returns HTTP 400
MAX_BATCH_ROWS=10000

# -----------------------------------------------------------------------------
# 7. Persistent Token Revocation Database
# -----------------------------------------------------------------------------
# Path to local SQLite file tracking revoked tokens across server restarts.
REVOCATION_DB_PATH=data/revoked_tokens.db

# -----------------------------------------------------------------------------
# 8. Frontend Streamlit Configuration
# -----------------------------------------------------------------------------
# Target backend REST API URL
API_BASE_URL=http://127.0.0.1:8000
